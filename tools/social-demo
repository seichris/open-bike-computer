PROJECT = 'bicino-dev'
ORIGIN = 'https://maps-dev.8o.vc/v1/social'
CONTAINER = 'bicino-social-dev-social-api-1'
REMOTE_ROOT = '/opt/bicino-social-dev/demo-friends'
PROGRAM = '/tmp/bicino-social-demo.py'
CONFIG = '/tmp/bicino-social-demo-config.json'
