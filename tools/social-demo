PID = '/tmp/bicino-social-demo.pid'
STOPPED = False
class DemoError(Exception):
    pass


def safe_error(error):
    text = str(error)
    return text if isinstance(error, DemoError) and re.fullmatch(r'[a-zA-Z0-9_: -]{1,140}', text) else type(error).__name__


RIDERS = (('ava', 'Demo Ava', 5.5), ('ben', 'Demo Ben', 3.7), ('cleo', 'Demo Cleo', 0.0))
EMOJIS = {'ava': '🚴', 'ben': '🚴‍♂️', 'cleo': '🚴‍♀️'}
# Metres forward and right relative to the receiving rider's travel direction.
FORMATION = {'ava': (0, 25), 'ben': (-65, -12), 'cleo': (-140, 30)}


class FollowingTrack:
    """Only consume the target's currently consented, fresh friend snapshot."""
    def __init__(self):
        self.course = 0.0

    def anchor(self, snapshot, target_id):
        own = next((r for r in snapshot['riders'] if r['profile']['id'] == target_id), None)
        if own is None: return None
        values = [own.get(key) for key in ('latitude', 'longitude', 'age')]
        if not all(isinstance(v, (int, float)) and math.isfinite(v) for v in values): return None
        latitude, longitude, age = values
        if not (-90 <= latitude <= 90 and -180 <= longitude <= 180 and 0 <= age <= 15): return None
        course = own.get('course')
        if isinstance(course, (int, float)) and math.isfinite(course) and 0 <= course < 360:
            self.course = course
        return own

    def sample(self, slug, anchor, elapsed, captured_at, sequence, epoch, target_id):
        forward, right = FORMATION[slug]
        bearing = math.radians(self.course + math.degrees(math.atan2(right, forward)))
        distance = math.hypot(forward, right) / 6371000
        lat, lon = math.radians(anchor['latitude']), math.radians(anchor['longitude'])
        target_lat = math.asin(max(-1, min(1, math.sin(lat)*math.cos(distance) +
                              math.cos(lat)*math.sin(distance)*math.cos(bearing))))
        target_lon = lon + math.atan2(math.sin(bearing)*math.sin(distance)*math.cos(lat),
                                     math.cos(distance)-math.sin(lat)*math.sin(target_lat))
        speed = anchor.get('speed', 0)
        if not isinstance(speed, (int, float)) or not math.isfinite(speed): speed = 0
        speed = max(0, min(60, speed))
        return {'latitude': math.degrees(target_lat), 'longitude': (math.degrees(target_lon)+180) % 360-180,
                'horizontalAccuracy': 5, 'capturedAt': captured_at, 'sequence': sequence,
                'epochs': {target_id: epoch}, 'course': self.course, 'speed': speed,
                'elapsedSeconds': min(604800, max(0, elapsed))}


def publish_tick(accounts, target_id, elapsed, track=None):
    """A missing/revoked anchor clears every demo stream; never reuse a cached fix."""
    anchor, anchor_error = None, None
    requested_at = time.monotonic()
    if track is not None:
        try:
            anchor = track.anchor(accounts[0].call('GET', '/friend-sharing'), target_id)
        except Exception as error:
            anchor_error = safe_error(error)
    outcomes = []
    for account in accounts:
        if STOPPED: break
        state = {'username': account.username, 'displayName': account.name, 'publishing': False}
        try:
            if track is None or (anchor is not None and anchor['age'] + time.monotonic()-requested_at <= 15):
                if account.epoch is None or time.monotonic() >= account.lease_deadline:
                    account.change_consent(target_id, True)
            # Authentication and consent renewal can block; check freshness again afterwards.
            if track is not None and (anchor is None or anchor['age'] + time.monotonic()-requested_at > 15):
                if account.epoch is not None: account.change_consent(target_id, False)
                state.update(scenario='waiting_for_your_location', seesYourSharing=False, receivesStats=False)
                if anchor_error: state['error'] = anchor_error
            else:
                fix = (track.sample(account.slug, anchor, elapsed, time.time(), account.sequence, account.epoch, target_id)
                       if track is not None else
                       sample(account.slug, elapsed, time.time(), account.sequence, account.epoch, target_id))
                if fix:
                    account.sequence += 1  # Never reuse a sequence after a lost reply.
                    reply = account.call('POST', '/friend-sharing/state', fix)
                    if target_id not in reply['accepted']:
                        account.epoch = None
                        raise DemoError('sharing_revoked')
                if track is None:
                    incoming = account.call('GET', '/friend-sharing')['riders']
                    own = next((r for r in incoming if r['profile']['id'] == target_id), None)
                else:
                    own = anchor if account.slug == 'ava' else None
                state.update(publishing=fix is not None, seesYourSharing=own is not None,
                             receivesStats=own is not None and 'distanceMeters' in own,
                             scenario='following' if track is not None else
                             'intermittent' if account.slug == 'cleo' else 'moving')
        except Exception as error:
            state['error'] = safe_error(error)
        outcomes.append(state)
    return outcomes


def render_avatars():
    """Render system emoji on the operator's Mac; no font/image bundle is shipped."""
    if sys.platform != 'darwin': raise DemoError('Emoji avatars require the Mac operator')
    program = r'''
import AppKit
import Foundation
let entries: [(String, String, NSColor)] = [
    ("ava", "🚴", NSColor(red: 1, green: 0.94, blue: 0.73, alpha: 1)),
    ("ben", "🚴‍♂️", NSColor(red: 0.87, green: 0.94, blue: 1, alpha: 1)),
    ("cleo", "🚴‍♀️", NSColor(red: 0.85, green: 0.96, blue: 0.86, alpha: 1))
]
guard let font = NSFont(name: "AppleColorEmoji", size: 168) else { exit(1) }
var output: [String: String] = [:]
for (slug, emoji, background) in entries {
    guard let bitmap = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: 256, pixelsHigh: 256,
        bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
        colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0),
        let context = NSGraphicsContext(bitmapImageRep: bitmap) else { exit(1) }
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = context
    background.setFill(); NSBezierPath(rect: NSRect(x: 0, y: 0, width: 256, height: 256)).fill()
    let text = NSAttributedString(string: emoji, attributes: [.font: font])
    let size = text.size()
    text.draw(at: NSPoint(x: (256-size.width)/2, y: (256-size.height)/2))
    context.flushGraphics(); NSGraphicsContext.restoreGraphicsState()
    guard let data = bitmap.representation(using: .png, properties: [:]) else { exit(1) }
    output[slug] = data.base64EncodedString()
