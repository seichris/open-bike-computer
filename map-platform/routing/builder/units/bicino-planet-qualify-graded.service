# One stage of the planet build. run_stage.py records its state in export/chain/
# and refuses to start it until the stages it needs are done (chain_state.py).
[Unit]
Description=Bicino planet builder: probe the graded archive
Wants=docker.service network-online.target bicino-planet-build-graded.service bicino-planet-inputs.service
After=docker.service network-online.target bicino-planet-build-graded.service bicino-planet-inputs.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=bicino
Group=bicino
SupplementaryGroups=docker
Environment=BICINO_SCRATCH=/srv/bicino-routing-scratch
EnvironmentFile=/srv/bicino-routing-scratch/builder.env
ExecStart=/usr/bin/python3 /srv/bicino-routing-scratch/tools/repo/map-platform/routing/builder/run_stage.py qualify-graded
ExecStopPost=/usr/bin/python3 /srv/bicino-routing-scratch/tools/repo/map-platform/routing/builder/run_stage.py --finalize qualify-graded
TimeoutStartSec=1h
