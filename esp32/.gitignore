.pio
# Generated by pioarduino's custom-core ESP-IDF library build before the
# firmware identity is stamped. Keeping these ignored prevents a clean build
# from falsely advertising a dirty Git identity.
.dummy/
managed_components/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/extensions.json
.vscode/launch.json
.vscode/ipch
.vscode/settings.json
assets
tools/*.raw
tools/*.png
.DS_Store
