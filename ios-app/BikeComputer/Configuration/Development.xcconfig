// Development builds install beside the App Store release and keep their
// application data, permissions, and Keychain credentials isolated.
BICINO_IOS_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.dev
BICINO_WATCH_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.dev.watchkitapp
BICINO_WATCH_COMPLICATION_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.dev.watchkitapp.complications
BICINO_LIVE_ACTIVITY_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.dev.WorkoutLiveActivity
BICINO_APP_DISPLAY_NAME = Bicino Dev
BICINO_COMPLICATION_DISPLAY_NAME = Start Ride Dev
BICINO_URL_SCHEME = bikecomputer-dev
BICINO_APP_ICON_NAME = AppIconDev
BICINO_MAP_SERVICE_HOST = maps-dev.8o.vc
// Set to the exact account R2 S3 hostname during the infrastructure rollout.
// Shared-map downloads fail closed while this remains unconfigured.
BICINO_MAP_R2_DOWNLOAD_HOST = invalid.invalid
