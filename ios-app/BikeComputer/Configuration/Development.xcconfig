#include "HealthKitZones.xcconfig"

// Development builds install beside the App Store release and keep their
// application data, permissions, and Keychain credentials isolated.
BICINO_IOS_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.dev
BICINO_WATCH_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.dev.watchkitapp
BICINO_WATCH_COMPLICATION_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.dev.watchkitapp.complications
BICINO_LIVE_ACTIVITY_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.dev.WorkoutLiveActivity
BICINO_APP_DISPLAY_NAME = Bicino Dev
BICINO_COMPLICATION_DISPLAY_NAME = Start Ride Dev
BICINO_URL_SCHEME = bikecomputer-dev
BICINO_APP_ICON_NAME = AppIconDev
BICINO_APP_ATTEST_ENVIRONMENT = development
BICINO_MAP_SERVICE_HOST = maps-dev.8o.vc
// Bicino Dev shares the production library identity and catalog with Bicino.
// Staging validation builds override this setting at build time.
BICINO_MAP_CATALOG_HOST = maps-share.8o.vc
// Exact Cloudflare account S3 hostname; bucket names remain path components.
BICINO_MAP_R2_DOWNLOAD_HOST = 5834cd65d5f197557149dbc10074d37f.r2.cloudflarestorage.com
// Public verification identity for the dedicated development signer.
// Bicino Dev accepts it in addition to production signers; Bicino never does.
BICINO_MAP_DEVELOPMENT_SIGNING_KEY_ID = map-dev-2026-08
BICINO_MAP_DEVELOPMENT_SIGNING_PUBLIC_KEY_X963_HEX = 04a3b3bec1db96a28ca372e203af005936427e20ddba7dc7e955dfb42ec701e91a99b1d9dc45dd3565aecf2f165cce3a5292c22066e5494fe002660bb08f0b1241

// Public Firebase client configuration; account credentials stay in the app-private Keychain.
BICINO_FIREBASE_APP_ID = 1:508574122896:ios:6edaa42944894d22b86915
BICINO_FIREBASE_SENDER_ID = 508574122896
BICINO_FIREBASE_API_KEY = AIzaSyAqEA5LP16RFDQcPXBMeqEvGOPsuIEZ1b0
BICINO_FIREBASE_PROJECT_ID = bicino-dev
BICINO_GOOGLE_CLIENT_ID = 508574122896-bg7ciq6ecdsq0j450mduvnfp9c7ubsko.apps.googleusercontent.com
BICINO_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.508574122896-bg7ciq6ecdsq0j450mduvnfp9c7ubsko

BICINO_APNS_ENVIRONMENT = development
