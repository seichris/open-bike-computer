#include "HealthKitZones.xcconfig"

// Production identities must stay aligned with the App Store record and its
// embedded Apple Watch and WidgetKit products.
BICINO_IOS_BUNDLE_IDENTIFIER = LetItRide.BikeComputer
BICINO_WATCH_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.watchkitapp
BICINO_WATCH_COMPLICATION_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.watchkitapp.complications
BICINO_LIVE_ACTIVITY_BUNDLE_IDENTIFIER = LetItRide.BikeComputer.WorkoutLiveActivity
BICINO_APP_DISPLAY_NAME = Bicino
BICINO_COMPLICATION_DISPLAY_NAME = Start Ride
BICINO_URL_SCHEME = bikecomputer
BICINO_APP_ICON_NAME = AppIcon
BICINO_APP_ATTEST_ENVIRONMENT = production
BICINO_MAP_SERVICE_HOST = maps.8o.vc
BICINO_MAP_CATALOG_HOST = maps-share.8o.vc
// Exact Cloudflare account S3 hostname; bucket names remain path components.
BICINO_MAP_R2_DOWNLOAD_HOST = 5834cd65d5f197557149dbc10074d37f.r2.cloudflarestorage.com
// Production builds intentionally never add a development signing key.
BICINO_MAP_DEVELOPMENT_SIGNING_KEY_ID =
BICINO_MAP_DEVELOPMENT_SIGNING_PUBLIC_KEY_X963_HEX =

// Public Firebase client configuration; account credentials stay in the app-private Keychain.
BICINO_FIREBASE_APP_ID = 1:578330303218:ios:fcc893df60771bd1d60e6b
BICINO_FIREBASE_SENDER_ID = 578330303218
BICINO_FIREBASE_API_KEY = AIzaSyAt1IoeVRCF8lGTO5tkXfKyaXXAnMFrtFw
BICINO_FIREBASE_PROJECT_ID = bicino-prod
BICINO_GOOGLE_CLIENT_ID = 578330303218-qbvs9sa1nuvk8rf3ufqe1lmf8adrv2mi.apps.googleusercontent.com
