<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BicinoMapServiceHost</key>
	<string>$(BICINO_MAP_SERVICE_HOST)</string>
	<key>BicinoMapCatalogHost</key>
	<string>$(BICINO_MAP_CATALOG_HOST)</string>
	<key>BicinoMapR2DownloadHost</key>
	<string>$(BICINO_MAP_R2_DOWNLOAD_HOST)</string>
	<key>BicinoMapDevelopmentSigningKeyID</key>
	<string>$(BICINO_MAP_DEVELOPMENT_SIGNING_KEY_ID)</string>
	<key>BicinoMapDevelopmentSigningPublicKeyX963Hex</key>
	<string>$(BICINO_MAP_DEVELOPMENT_SIGNING_PUBLIC_KEY_X963_HEX)</string>
	<key>CFBundleDisplayName</key>
	<string>$(BICINO_APP_DISPLAY_NAME)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- 
		Info.plist Configuration Template for Bicino
	
	IMPORTANT: Copy these entries to your Info.plist or configure in Xcode:
	1. Select your target
	2. Go to "Info" tab
	3. Add these keys under "Custom iOS Target Properties"
	-->
	
	<!-- Location Permissions -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Bicino uses background location for navigation, iPhone cycling workout routes, and optional ride detection while the app is not visible.</string>
	
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Bicino uses your location for navigation, iPhone cycling workout routes and distance, and optional ride detection.</string>
	
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Bicino uses background location to continue navigation, iPhone workout routes, and optional ride detection when the app is not visible.</string>

	<!-- Bluetooth Permission -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bicino uses Bluetooth to connect to your ESP32 bike computer display.</string>
	
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Bicino uses Bluetooth to communicate with your bike computer display.</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>Bicino connects to your bike computer over local Wi-Fi for device transfers and diagnostics.</string>
	
	<key>NSHealthShareUsageDescription</key>
	<string>Bicino reads cycling workout metrics and summaries from iPhone or Apple Watch.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Bicino saves cycling workouts, cycling distance, and permitted routes to HealthKit from your selected recorder.</string>

	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>
	
	<!-- Location Accuracy -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>Navigation</key>
			<string>Bicino uses precise location for accurate navigation and ride detection.</string>
	</dict>
	
	<!-- Supported Interface Orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- App Transport Security (allow local development) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	
	<!-- Launch Screen -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>LaunchImage</string>
	</dict>
</dict>
</plist>
